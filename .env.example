# Copia este archivo como .env.local y llena los valores.

# Base de datos Postgres (Supabase, Neon, etc.).
# Si lo dejas vacío en desarrollo, se usa una base local en la carpeta .data/
DATABASE_URL=

# Texto largo y aleatorio para firmar las sesiones del personal. Obligatorio en producción.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Usuario desarrollador que se crea la primera vez que arranca el sistema.
BOOTSTRAP_USER=dev
BOOTSTRAP_PASSWORD=cambia-esta-clave

# Solo para probar "npm run build && npm start" en tu computadora sin DATABASE_URL.
# LOCAL_DB=1
